# Mukti — Environment Variables
# Copy this file to .env and fill in your values.
# All variables below have sensible defaults for local development via Docker Compose.

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# ── Session / Security ──────────────────────────────────────────────────────
SESSION_SECRET=dev-session-secret

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── AI (OpenRouter) ─────────────────────────────────────────────────────────
# Required for Socratic dialogue, canvas insights, and all AI features.
# Get a free key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# ── AI provider ─────────────────────────────────────────────────────────────
# openrouter (default): hosted models through OPENROUTER_API_KEY.
# claude | agy: run on the AI CLI of that name, installed and signed in, instead
# — no API key, no quota. Each provider is named after its command; the older
# names claude-code and antigravity still work. `start:local` and `npx muktiai`
# set this themselves (pick with --provider); set it here only when running the
# API directly in local mode. Antigravity costs roughly 15k input tokens and
# 30–45 seconds per reply — see the README before choosing it.
# AI_PROVIDER=openrouter
#
# agy only: the directory agy runs from, which also names the agy
# project Mukti's replies are filed under. Defaults to ~/.mukti/mukti-socratic.
# Never point it inside a repository: agy would pick up that repo's own rules.
# MUKTI_AGY_WORKSPACE=

# ── Google OAuth (optional) ─────────────────────────────────────────────────
# Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
COOKIE_DOMAIN=localhost
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ── Dialogue Quality Guardrails (RFC-0004) ──────────────────────────────────
DIALOGUE_QUALITY_SINGLE_QUESTION_ENABLED=true
DIALOGUE_QUALITY_BREAKTHROUGH_ENABLED=true
DIALOGUE_QUALITY_MISCONCEPTION_ENABLED=true
DIALOGUE_QUALITY_MISCONCEPTION_MODEL=google/gemini-3-flash-preview
