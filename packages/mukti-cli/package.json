{
  "name": "muktiai",
  "version": "0.1.0",
  "description": "Run Mukti — a Socratic thinking workspace — locally with one command.",
  "author": "Mukti",
  "license": "MIT",
  "homepage": "https://mukti.chat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shettydev/mukti.git",
    "directory": "packages/mukti-cli"
  },
  "bugs": {
    "url": "https://github.com/shettydev/mukti/issues"
  },
  "keywords": [
    "mukti",
    "socratic",
    "thinking",
    "claude-code"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "bin": {
    "muktiai": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "format": "prettier --write \"src/**/*.{ts,mjs}\" \"*.{mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,mjs}\" \"*.{mjs,json}\"",
    "lint": "eslint \"src/**/*.{ts,mjs}\" esbuild.config.mjs",
    "lint:fix": "eslint \"src/**/*.{ts,mjs}\" esbuild.config.mjs --fix",
    "test": "node --test \"src/**/*.test.ts\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@muktiai/api": "0.1.1-beta.0",
    "@muktiai/web": "0.2.1-beta.0",
    "mongodb-memory-server": "^11.2.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
