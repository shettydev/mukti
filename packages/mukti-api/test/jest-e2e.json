{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "globalSetup": "<rootDir>/cli-stubs.global-setup.ts",
  "globalTeardown": "<rootDir>/cli-stubs.global-teardown.ts",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!(@openrouter|@scalar|uuid)/)"],
  "watchman": false
}
